@if (ActionCrud == CrudOperation.Delete && ActionItem != null)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm delete</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>@DeleteMessage(ActionItem)</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmDeleteAsync">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {

    /// <summary>
    /// Whether to show the column selector above the grid. Defaults to false.
    /// </summary>
    [Parameter]
    public bool ShowColumnSelector { get; set; } = false;

    private async Task ColumnSelectionChangedAsync()
    {
        if (MyGrid is null) return;
        await MyGrid.RefreshDataAsync();
    }
}
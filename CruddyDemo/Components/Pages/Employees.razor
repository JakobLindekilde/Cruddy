@page "/Employees"
@inject Microsoft.Data.SqlClient.SqlConnection dbConnection

<h3>Table Employees</h3>

<h4>Employees with salary > 45000</h4>
<Cruddy TableName="Employees" TableColumns="Id, Name, Salary" Where="Salary > 45000" DbConnection="dbConnection" />

<br />
<h4>All employees</h4>
<Cruddy TableName="Employees" TableColumns="Id, Name, Salary" AllowDetails="true" DbConnection="dbConnection" />


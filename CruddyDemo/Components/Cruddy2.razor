@using Dapper;
@using Microsoft.AspNetCore.Components.QuickGrid

@if (ShowTechInfo.GetValueOrDefault())
{
    <pre>
        TechInfo:
        --------------------------------------------------
        TableName @TableName
        --------------------------------------------------
    </pre>
}

@if (items is null)
{
    <p>Loading data...</p>
}
else if (!items.Any())
{
    <p>No data found.</p>
}
else
{
    <div class="grid">
        <QuickGrid id="MyGrid" Items="@items">
            <PropertyColumn Property="@(p => p.Id)" Sortable="true" />
            <PropertyColumn Property="@(p => p.Name)" Sortable="true" />
            <PropertyColumn Property="@(p => p.Email)" Sortable="true" />
            <PropertyColumn Property="@(p => p.Phone)" Sortable="true" />
        </QuickGrid>
    </div>
}

@code {
    [Parameter]
    public required string TableName { get; set; }

    [Parameter]
    public required System.Data.Common.DbConnection DbConnection { get; set; }

    [Parameter]
    public bool? ShowTechInfo { get; set; }

    protected IQueryable<Models.Customer>? items;

    protected IQueryable<T> GetTableRows<T>(System.Data.Common.DbConnection DbConnection, string tableName, string cols = "*")
    {
        var sql = $"SELECT {cols} FROM dbo.{tableName}";
        IEnumerable<dynamic> dynRows = DbConnection.Query(sql);
        return Helpers.DynamicHelper.MapDynRows<T>(dynRows).AsQueryable();
    }

    public override async Task SetParametersAsync(ParameterView parameters)
    {
        await base.SetParametersAsync(parameters);

        string? tableName = null;
        if (parameters.TryGetValue<string>(nameof(TableName), out var value))
        {
            if (value is not null)
            {
                tableName = value.Trim();
                items = GetTableRows<Models.Customer>(DbConnection, tableName);
            }
        }
    }
}

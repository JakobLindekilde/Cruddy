@using Microsoft.AspNetCore.Components.QuickGrid
@using QuickGrid.Toolkit
@using CruddyDemo.Helpers
@inherits CruddyBase<TEntity>
@typeparam TEntity

@if (Rows is null)
{
    <p>Loading data...</p>
}

else if (!Rows.Any())
{
    <p>No data found.</p>
}
else
{
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@ErrorMessage</div>
    }

    @if (ShowColumnSelector)
    {
        <div>
            <ColumnSelector ColumnManager="MyColumnManager" SelectionChanged="SelectionChangedAsync" />
        </div>
    }

    <QuickGrid @ref="MyGrid" id="CruddyGrid" Items="@Rows.AsQueryable()" Class="table table-sm table-index table-striped small table-fit table-thead-sticky mb-0" Theme="twentyAI">
        @QuickGridColumns.Columns(MyColumnManager)
    </QuickGrid>

    @if (ShowDetailsModal && DetailsItem != null)
    {
        <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Details - @typeof(TEntity).Name</h5>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CloseDetails"></button>
                    </div>
                    <div class="modal-body">
                        <table class="table table-sm table-striped">
                            <tbody>
                                @foreach (var prop in PropertyHelper.GetPublicProperties(typeof(TEntity)))
                                {
                                    if (!PropertyHelper.Supported(prop.PropertyType)) continue;

                                    var displayName = PropertyHelper.GetDisplayName(prop);
                                    var formattedValue = PropertyHelper.GetFormattedValue(prop, DetailsItem);
                                    <tr>
                                        <th>@displayName</th>
                                        <td>@formattedValue</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CloseDetails">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (ShowEditModal && EditItem != null)
    {
        <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Edit - @typeof(TEntity).Name</h5>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CancelEdit"></button>
                    </div>
                    <div class="modal-body">
                        <EditForm EditContext="@(EditCtx!)" OnValidSubmit="ConfirmEditAsync">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <table class="table table-sm table-striped">
                                <tbody>
                                    @foreach (var prop in PropertyHelper.GetPublicProperties(typeof(TEntity)))
                                    {
                                        if (!PropertyHelper.Supported(prop.PropertyType)) continue;

                                        var displayName = PropertyHelper.GetDisplayName(prop);
                                        var val = prop.GetValue(EditItem);

                                        <tr>
                                            <th>@displayName</th>
                                            <td>
                                                @{
                                                    var type = PropertyHelper.GetUnderlyingType(prop.PropertyType);

                                                    if (PropertyHelper.IsNumber(type.Name))
                                                    {
                                                        <input type="number" class="form-control" value="@(val?.ToString() ?? string.Empty)" @onchange="(e) => OnFieldChanged(prop, e.Value)" />
                                                    }
                                                    else if (PropertyHelper.IsDecimal(type.Name))
                                                    {
                                                        <input type="number" step="any" class="form-control" value="@(val?.ToString() ?? string.Empty)" @onchange="(e) => OnFieldChanged(prop, e.Value)" />
                                                    }
                                                    else if (type == typeof(bool))
                                                    {
                                                        <input type="checkbox" class="form-check-input" checked="@(val is bool b && b)" @onchange="(e) => OnFieldChanged(prop, e.Value)" />
                                                    }
                                                    else if (type == typeof(DateTime))
                                                    {
                                                        var dateVal = val is DateTime dt ? dt.ToString("yyyy-MM-dd") : string.Empty;
                                                        <input type="date" class="form-control" value="@dateVal" @onchange="(e) => OnFieldChanged(prop, e.Value)" />
                                                    }
                                                    else
                                                    {
                                                        <input type="text" class="form-control" value="@(val?.ToString() ?? string.Empty)" @onchange="(e) => OnFieldChanged(prop, e.Value)" />
                                                    }
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <div class="modal-footer">
                                <button class="btn btn-secondary" type="button" @onclick="CancelEdit">Cancel</button>
                                <button class="btn btn-primary" type="submit">Save</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (ShowDeleteModal && DeletePendingItem != null)
    {
        <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirm delete</h5>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CancelDelete"></button>
                    </div>
                    <div class="modal-body">
                        <p>@DeleteMessage(DeletePendingItem)</p>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                        <button class="btn btn-danger" @onclick="ConfirmDeleteAsync">Delete</button>
                    </div>
                </div>
            </div>
        </div>
    }

}

@code {

    /// <summary>
    /// Whether to show the column selector above the grid. Defaults to false.
    /// </summary>
    [Parameter]
    public bool ShowColumnSelector { get; set; } = false;

    private async Task SelectionChangedAsync()
    {
        if (MyGrid is null) return;
        await MyGrid.RefreshDataAsync();
    }
}
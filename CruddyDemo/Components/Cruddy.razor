@using Microsoft.AspNetCore.Components.QuickGrid
@inherits CruddyBase<Models.Customer>

@if (ShowTechInfo.GetValueOrDefault())
{
    <pre>
        TechInfo:
        --------------------------------------------------
        TableName    : @TableName
        ShowTechInfo : @ShowTechInfo.GetValueOrDefault()
        --------------------------------------------------
    </pre>
}

@if (Rows is null)
{
    <p>Loading data...</p>
}
else if (!Rows.Any())
{
    <p>No data found.</p>
}
else
{
    <div class="grid">
        <QuickGrid id="MyGrid" Items="@Rows">
            <PropertyColumn Property="@(p => p.Id)" Sortable="true" />
            <PropertyColumn Property="@(p => p.Name)" Sortable="true" />
            <PropertyColumn Property="@(p => p.Email)" Sortable="true" />
            <PropertyColumn Property="@(p => p.Phone)" Sortable="true" />
        </QuickGrid>
    </div>
}


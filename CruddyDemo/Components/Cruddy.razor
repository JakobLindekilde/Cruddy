@using Microsoft.AspNetCore.Components.QuickGrid
@using QuickGrid.Toolkit
@typeparam TEntity

@if (ShowInfoMessage.GetValueOrDefault())
{
    <pre>InfoMessage : @InfoMessage</pre>
}

@if (Rows is null)
{
    <p>Loading data...</p>
}
else if (!Rows.Any())
{
    <p>No data found.</p>
}
else
{
    <QuickGrid @ref="MyGrid" id="@this.GetHashCode()" Items="@Rows" Class="table table-sm table-index table-striped small table-fit table-thead-sticky mb-0" Theme="twentyAI">
        @QuickGridColumns.Columns(ColumnManager)
    </QuickGrid>
}


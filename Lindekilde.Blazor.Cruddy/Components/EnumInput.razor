@using Microsoft.AspNetCore.Components

<select class="form-select" disabled="@Disabled" required="@Required" @onchange="HandleChange">
    @if (IsNullable)
    {
        <option value="">--</option>
    }

    @foreach (var enumValue in EnumType.GetEnumValues())
    {
        var enumName = enumValue?.ToString();
        var selected = Value != null && Value.ToString() == enumName;
        <option value="@enumName" selected="@selected">@enumName</option>
    }
</select>

@code {
    [Parameter, EditorRequired]
    public Type EnumType { get; set; } = default!;

    [Parameter]
    public object? Value { get; set; }

    [Parameter]
    public bool IsNullable { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public EventCallback<object?> ValueChanged { get; set; }

    private Task HandleChange(ChangeEventArgs args) => ValueChanged.InvokeAsync(args.Value);
}

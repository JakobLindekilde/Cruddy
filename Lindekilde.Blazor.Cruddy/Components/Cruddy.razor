@using Microsoft.AspNetCore.Components.QuickGrid
@using Lindekilde.Blazor.Cruddy.Helpers
@inherits CruddyBase

@if (!Rows.Any())
{
    <p>No data found.</p>
}

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@ErrorMessage</div>
}

@if (AllowCrud || AllowCreate)
{
    <div class="mb-2">
        <button class="btn btn-success" @onclick="() => ShowEdit(CrudOperation.Create)">Create</button>
    </div>
}

<QuickGrid TGridItem="CruddyRow" @ref="MyGrid" id="CruddyGrid" Items="@Rows.AsQueryable()" Class="@CruddyGridClass" Theme="@CruddyGridTheme">
    @foreach (var column in MyColumns)
    {
        @column
    }
</QuickGrid>

@if (ActionCrud == CrudOperation.Read && ActionItem != null)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Details - @TableName</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CancelAction"></button>
                </div>
                <div class="modal-body">
                    <table class="@ModalTableClass">
                        <tbody>
                            @foreach (var field in DetailsFields)
                            {
                                var ii = GetInputInfo(field, ActionItem, ActionCrud);
                                if (!ii.Visible) continue;
                                var fkeyOption = GetFkeyOption(field, ii);
                                <tr>
                                    <th>@ii.DisplayName</th>
                                    <td>@(fkeyOption is not null ? fkeyOption.Display : ii.FormattedValue)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelAction">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@if (ActionCrud == CrudOperation.Create || ActionCrud == CrudOperation.Update && ActionItem != null)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(ActionCrud == CrudOperation.Create ? "Create" : "Edit") - @TableName</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CancelAction"></button>
                </div>
                @if (!string.IsNullOrEmpty(EditErrorMessage))
                {
                    <div class="alert alert-danger" role="alert">@EditErrorMessage</div>
                }
                <div class="modal-body">
                    <EditForm EditContext="@(EditCtx!)" OnValidSubmit="ConfirmActionAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <table class="@ModalTableClass">
                            <tbody>
                                @foreach (var field in EditFields)
                                {
                                    var ii = GetInputInfo(field, ActionItem, ActionCrud);
                                    if (!ii.Visible)
                                    {
                                        <input type="hidden" class="form-control" value="@(ii.Value?.ToString() ?? string.Empty)" />
                                        continue;
                                    }
                                    <tr>
                                        <th>@ii.DisplayName</th>
                                        <td>
                                            @{
                                                var fkOptions = GetFKeyOptions(field);
                                                if (fkOptions != null)
                                                {
                                                    <ForeignKeyInput Options="fkOptions" Value="ii.Value" ShowEmptyOption="field.IsNullable || ActionCrud == CrudOperation.Create" Disabled="ii.Disabled" Required="ii.Required" ValueChanged="(value) => OnFieldChanged(field, value)" />
                                                }
                                                else if (TypeHelper.IsNumber(ii.Type) || TypeHelper.IsDecimal(ii.Type))
                                                {
                                                    <input type="number" step="@(TypeHelper.IsDecimal(ii.Type) ? "any" : null)" class="form-control" value="@(ii.Value?.ToString() ?? string.Empty)" disabled="@ii.Disabled" required="@ii.Required" @onchange="(e) => OnFieldChanged(field, e.Value)" />
                                                }
                                                else if (ii.Type == typeof(bool))
                                                {
                                                    <input type="checkbox" class="form-check-input" checked="@(ii.Value is bool b && b)" disabled="@ii.Disabled" @onchange="(e) => OnFieldChanged(field, e.Value)" />
                                                }
                                                else if (ii.Type == typeof(DateTime) && ii.DataType == System.ComponentModel.DataAnnotations.DataType.Date)
                                                {
                                                    <input type="date" class="form-control" value="@ii.InputDateTimeValue()" disabled="@ii.Disabled" required="@ii.Required" @onchange="(e) => OnFieldChanged(field, e.Value)" />
                                                }
                                                else if (ii.Type == typeof(DateTime))
                                                {
                                                    <input type="datetime-local" step="1" class="form-control" value="@ii.InputDateTimeValue()" disabled="@ii.Disabled" required="@ii.Required" @onchange="(e) => OnFieldChanged(field, e.Value)" />
                                                }
                                                else if (ii.Type == typeof(TimeSpan))
                                                {
                                                    <input type="time" step="1" class="form-control" value="@(ii.Value?.ToString() ?? string.Empty)" disabled="@ii.Disabled" required="@ii.Required" @onchange="(e) => OnFieldChanged(field, e.Value)" />
                                                }
                                                else
                                                {
                                                    <input type="text" class="form-control" value="@(ii.Value?.ToString() ?? string.Empty)" disabled="@ii.Disabled" required="@ii.Required" @onchange="(e) => OnFieldChanged(field, e.Value)" />
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div class="modal-footer">
                            <button class="btn btn-secondary" type="button" @onclick="CancelAction">Cancel</button>
                            <button class="btn btn-primary" type="submit">Save</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@if (ActionCrud == CrudOperation.Delete && ActionItem != null)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm delete</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CancelAction"></button>
                </div>
                <div class="modal-body">
                    <p>@DeleteMessage(ActionItem)</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelAction">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmDeleteAsync">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

